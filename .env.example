# API
API_PATH=/v1/product
PORT=9080
DEBUG=mati-arqsw:*

# Google Calendar service account
GOOGLE_CALENDAR_ID=your-calendar-id@example.com
GOOGLE_SERVICE_ACCOUNT_EMAIL=calendar-service@your-project.iam.gserviceaccount.com
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nREPLACE_WITH_YOUR_PRIVATE_KEY\n-----END PRIVATE KEY-----\n"

# MySQL connection (use the database credentials provided by your hosting provider)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=draangela
DB_USER=your-database-user
DB_PASSWORD=your-database-password

# Required to sign one-hour authentication tokens (at least 32 random bytes)
JWT_SECRET=replace-with-at-least-32-random-bytes

# Required by the protected POST /auth/users endpoint (at least 32 random bytes)
USER_PROVISIONING_TOKEN=replace-with-a-separate-random-provisioning-token
